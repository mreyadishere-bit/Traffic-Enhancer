TE_ENV=development
TE_API_KEY=replace-with-your-own-long-random-local-key
TE_DATA_DIR=./data
TE_MAX_UPLOAD_MB=150

# Optional inference models - all stages report "not_configured" when absent.
TE_YOLO_MODEL=
TE_YOLO_DEVICE=cpu
TE_TRACK_MAX_FRAMES=90
TE_TRACK_STRIDE=5

TE_ASR_MODEL=
TE_ASR_DEVICE=cpu
TE_ASR_COMPUTE_TYPE=int8
TE_ASR_ALLOW_DOWNLOAD=0

# Qwen2.5-VL-3B-Instruct, OFF until explicitly enabled.
TE_ENABLE_QWEN=0
TE_QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
TE_QWEN_DEVICE_MAP=auto
TE_QWEN_FRAMES=4
TE_QWEN_ALLOW_DOWNLOAD=0

# Requires separate Egyptian-plate detector weights
TE_PLATE_MODEL=
TE_OCR_GPU=0

# Alternative operator-controlled GPU server (optional, sends sampled frames only).
# External endpoints must use HTTPS; API key must be secret.
TE_QWEN_API_BASE=
TE_QWEN_API_KEY=
